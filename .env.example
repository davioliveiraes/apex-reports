# Copie este arquivo para `.env` (que o git ignora) e preencha.
#
#     cp .env.example .env
#
# O `settings.py` lê o `.env` da raiz do projeto no import. É só para
# DESENVOLVIMENTO: na VPS quem entrega estas variáveis é o systemd, lendo
# /etc/apex-reports/env, que o deploy/deploy.sh escreve — lá o `.env` nem
# existe. Variável já presente no ambiente sempre vence o que está aqui.


# ---- Análise do Período escrita por IA ----
# Sem a chave, o botão "Escrever análise com IA" não aparece na tela 02 e nada
# é chamado: o texto do motor de regras continua sendo o padrão.
# A chave sai de https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo usado na redação. Em branco, vale `gpt-5.6-sol`. A linha 5.6 não tem
# um `gpt-5.6` puro: são três variantes (`-sol`, `-luna`, `-terra`) e o nome
# curto devolve 404. Confira os nomes que a SUA chave enxerga em
# https://platform.openai.com/docs/models — modelo que não existe derruba a
# análise por IA (o relatório continua saindo com o texto do motor de regras).
OPENAI_MODEL=


# ---- Django ----
# Nenhuma destas é necessária em desenvolvimento: `manage.py runserver` liga o
# DEBUG sozinho e, com DEBUG ligado, o settings cai numa SECRET_KEY local. Só
# preencha para reproduzir o comportamento de produção na sua máquina — e note
# que DJANGO_DEBUG aqui NÃO desliga o modo de desenvolvimento, porque o
# manage.py já o ligou antes de este arquivo ser lido.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=
# DJANGO_ALLOWED_HOSTS=
#
# Estas duas só fazem sentido na VPS, e lá quem as escreve é o deploy:
# DJANGO_STATIC_ROOT é o destino do collectstatic fora do home do usuário, e
# DJANGO_SCRIPT_NAME é o subcaminho em que o nginx publica (/apex-reports).
# DJANGO_STATIC_ROOT=
# DJANGO_SCRIPT_NAME=
